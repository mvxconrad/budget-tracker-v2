# Copy to .env and fill in. Each feature lights up only when its key is present.

# --- AI assistant (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Auth (JWT) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=43200

# --- CORS: where the frontend runs ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limiting: shared store for multi-instance (leave unset = in-memory, single instance) ---
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379

# --- Market data (later) ---
FINNHUB_API_KEY=

# --- Bank linking via Plaid (later) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
