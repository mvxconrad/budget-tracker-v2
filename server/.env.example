# Copy to .env and fill in. Each feature lights up only when its key is present.

# --- Database ---
# Local dev (default if unset): sqlite+aiosqlite:///./quarterbyte_dev.db
# Production (RDS Postgres): postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# --- Swagger docs auth (Basic). Set both in prod to require login at /api/docs.
# Leave blank in dev to keep docs open locally.
DOCS_USER=
DOCS_PASSWORD=

# --- Encryption at rest for per-user API keys (Fernet) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key is derived from JWT_SECRET (ok for dev; set explicitly in prod).
APP_ENCRYPTION_KEY=

# --- AI assistant (Anthropic) — server fallback key ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Auth (JWT + refresh) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
REFRESH_EXPIRE_DAYS=30

# --- Email verification ---
# console = print the 6-digit code to the server log (dev, zero setup)
# ses     = send via AWS SES (needs a verified sender identity + IAM perms)
# gmail   = send via Gmail SMTP (needs SMTP_USER + a Gmail App Password)
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@yourdomain.com   # SES-verified identity (ses) or your Gmail address (gmail)
SES_REGION=us-west-2
SES_CONFIGURATION_SET=               # optional: SES config set for bounce/complaint tracking
# Gmail SMTP (EMAIL_PROVIDER=gmail). Create an App Password at
# https://myaccount.google.com/apppasswords (requires 2FA), not your login password.
SMTP_USER=                           # your Gmail address
SMTP_PASSWORD=                       # the 16-char app password

# --- CORS: where the frontend runs ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limiting: shared store for multi-instance (leave unset = in-memory, single instance) ---
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379
